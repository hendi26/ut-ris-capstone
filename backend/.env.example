# ─── Application ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────
POSTGRES_USER=ris_user
POSTGRES_PASSWORD=ris_password
POSTGRES_DB=ris_db
DATABASE_URL=postgresql+asyncpg://ris_user:ris_password@localhost:5432/ris_db

# ─── Security (ganti dengan key yang kuat di produksi!) ───────────
SECRET_KEY=changeme-generate-a-strong-secret-key-min-32-chars

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Orthanc PACS Simulasi ────────────────────────────────────────
# Catatan: Orthanc digunakan sebagai PACS simulasi selama fase capstone.
# Koneksi ke PACS produksi RSI Bogor direncanakan setelah validasi sistem.
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=orthanc
